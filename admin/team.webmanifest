{
  "name": "MUKTalent",
  "short_name": "MUKTalent",
  "description": "MUKTalent team workspace and Global Passport student portal.",
  "id": "/login/",
  "start_url": "/login/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#F6F4F0",
  "theme_color": "#161514",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://www.muktalent.com/admin/team.webmanifest"
    }
  ]
}
