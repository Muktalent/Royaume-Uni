{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:admin && npm run build:personal && node tools/build-site.mjs",
  "outputDirectory": "web-dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__crm_route=:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/portal",
      "destination": "/admin/index.html"
    },
    {
      "source": "/portal/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/login",
      "destination": "/admin/index.html"
    },
    {
      "source": "/login/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:handle((?!(?:admin|api|portal|login|book|services|privacy|terms|portfolio|certificates|personal-admin|pipeline-share|assets|fonts|images|img|css|js)(?![a-zA-Z0-9-]))[a-zA-Z0-9][a-zA-Z0-9-]{1,28}[a-zA-Z0-9])",
      "destination": "/book/index.html"
    },
    {
      "source": "/:handle((?!(?:admin|api|portal|login|book|services|privacy|terms|portfolio|certificates|personal-admin|pipeline-share|assets|fonts|images|img|css|js)(?![a-zA-Z0-9-]))[a-zA-Z0-9][a-zA-Z0-9-]{1,28}[a-zA-Z0-9])/",
      "destination": "/book/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/book",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/book/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
