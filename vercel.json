{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  null,
    "buildCommand":  "npm run build:admin \u0026\u0026 node tools/build-site.mjs",
    "outputDirectory":  "web-dist",
    "functions":  {
                      "api/index.mjs":  {
                                            "includeFiles":  "server/{app.mjs,crm-config.json,validation.mjs,vercel-route.mjs,evaluation-public.mjs,evaluation-validation.mjs,exports.mjs,export-data.mjs}",
                                            "maxDuration":  30
                                        }
                  },
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "/api/index?__crm_route=:path*"
                     },
                     {
                         "source":  "/admin",
                         "destination":  "/admin/index.html"
                     },
                     {
                         "source":  "/admin/",
                         "destination":  "/admin/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/admin/:path*",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027; img-src \u0027self\u0027 data:; connect-src \u0027self\u0027 https://qximjrweeagjufsrewpy.supabase.co; object-src \u0027none\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027none\u0027; form-action \u0027self\u0027"
                                        }
                                    ]
                    }
                ],
    "redirects":  [
                      {
                          "source":  "/services/ielts-guidance/:path*",
                          "destination":  "/services/#anglais",
                          "permanent":  true
                      },
                      {
                          "source":  "/services/scholarships/:path*",
                          "destination":  "/services/university-applications/#financement",
                          "permanent":  true
                      }
                  ]
}